# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python (legacy)
.venv/
__pycache__/
*.py[cod]

# IDE / editor files
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# logs
logs/
*.log

# python files
.devcontainer/
legacy/

# Claude Code (keep local/personal settings out of the repo)
.claude/settings.local.json

# HTTPS dev certificates & private keys
/certificates/
*.pem
*.key